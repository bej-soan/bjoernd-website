        <img loading="lazy" class="single-case__image" src="/assets/images/case-images/bd-cases_drivebyheroes-2.jpg" alt="Detailansicht für {{ project.title }}"> 

        

        <div class="single-case__mobile-image-wrapper">

            <img loading="lazy" class="single-case__image single-case__image--mobile" src="/assets/images/case-images/bd-cases_drivebyheroes-mobile-1.jpg" alt="Detailansicht für {{ project.title }}">

