<li class="project-card">
    <a class="project-card__image-link" title="{{ cardContent.name | safe }} öffnen" href="{{ cardContent.href }}" target="_{% if cardContent.internalLink %}self{% else %}blank{% endif %}">
    <div class="project-card__project-image-wrapper">
        
        <img class="project-card__project-image"
        srcset="/assets/images/case-images-old/{{ cardContent.image }}@0,25x.jpg 576w,
                /assets/images/case-images-old/{{ cardContent.image }}@0,5x.jpg 960w,
                /assets/images/case-images-old/{{ cardContent.image }}@0,75x.jpg 1440w,
                /assets/images/case-images-old/{{ cardContent.image }}.jpg 1920w"
        src="/assets/images/case-images-old/{{ cardContent.image }}.jpg"
        alt="{{ cardContent.name | safe }}" loading="lazy">
    </div>
    </a>

    <div class="project-card__project-text-wrapper">
        <h3 class="project-card__title">{{ cardContent.name | safe }}</h3>

        {% if cardContent.subtitle %}
            <p class="project-card__subtitle">{{ cardContent.subtitle | safe }}</p>
        {% endif %}

        <a class="project-card__link {% if cardContent.internalLink %}project-card__link--internal{% else %}project-card__link--external{% endif %}" target="_{% if cardContent.internalLink %}self{% else %}blank{% endif %}" href="{{ cardContent.href }}" title="{{ cardContent.name | safe }} öffnen">{{ cardContent.clean | safe }}</a>
    </div>

</li>